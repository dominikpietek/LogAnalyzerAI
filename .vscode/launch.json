{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "stackscout",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["stackscout.api.server:app", "--host", "127.0.0.1", "--port", "8000"],
      "python": "${workspaceFolder}/env/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/local.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "jinja": true,
      "justMyCode": false
    }
  ]
}
